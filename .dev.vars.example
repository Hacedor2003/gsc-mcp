# Copy to .dev.vars for `npm run worker:dev`. Never commit .dev.vars.
MCP_AUTH_TOKEN=replace-with-output-of-openssl-rand-hex-32
GSC_CLIENT_ID=
GSC_CLIENT_SECRET=
GSC_REFRESH_TOKEN=
# or: GSC_SERVICE_ACCOUNT_JSON={"client_email":"...","private_key":"..."}
# GSC_ALLOWED_SITES=sc-domain:example.com
# GSC_READ_ONLY=1
